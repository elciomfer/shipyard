{
  "files.eol": "\n",
  "editor.tabSize": 2,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  "tailwindCSS.classFunctions": ["cn", "clsx", "cva"],
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.next": true,
    "**/.vscode": false,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/out": true,
    "**/.next": true,
    "bun.lock": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/out/**": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "bun.lock, .prettierrc*, .prettierignore, .gitignore, .editorconfig",
    "tsconfig.json": "tsconfig.*.json, next-env.d.ts",
    "next.config.*": "postcss.config.*, eslint.config.*"
  }
}
